<%- include('partials/header') %>
<main>
    <h1><%= project.title %></h1>
    <p><%= project.description %></p>
    <p>Date: <%= project.project_date %></p>
    <p>Location: <%= project.location %></p>
    <p>Organization: <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
    <h3>Categories</h3>
    <ul>
        <% categories.forEach(category => { %>
            <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
        <% }) %>
    </ul>
    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
        <p><a href="/assign-categories/<%= project.project_id %>">Assign Categories</a></p>
    <% } %>

    <% if (user) { %>
    <% if (userIsVolunteering) { %>
        <p>You are volunteering for this project.</p>
        <form action="/remove-volunteer/<%= project.project_id %>" method="POST">
            <button type="submit">Remove Myself as Volunteer</button>
        </form>
    <% } else { %>
        <form action="/volunteer/<%= project.project_id %>" method="POST">
            <button type="submit">Volunteer for This Project</button>
        </form>
        <% } %>
    <% } %>
</main>
<%- include('partials/footer') %>